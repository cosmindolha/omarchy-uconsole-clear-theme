#!/bin/bash
# A renderer failure must end the screensaver, never create an input-starving loop.
command -v ttfx >/dev/null || { echo 'Screensaver unavailable: ttfx is not installed.' >&2; exit 1; }
renderer=
cleanup() {
  trap - EXIT INT TERM HUP QUIT
  if [[ -n $renderer ]]; then kill "$renderer" 2>/dev/null || true; wait "$renderer" 2>/dev/null || true; fi
  printf '\033[?1000l\033[?1006l\033[?25h' 2>/dev/null || true
  hyprctl eval 'hl.config({cursor={invisible=false}})' >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP QUIT
hyprctl eval 'hl.config({cursor={invisible=true}})' >/dev/null 2>&1 || true
printf '\033]11;rgb:00/00/00\007\033[?1000h\033[?1006h'
# Wait for the fullscreen terminal's actual size, with a bounded deadline.
deadline=$((SECONDS+2))
while ((SECONDS<deadline)) && [[ $(stty size 2>/dev/null) == '24 80' ]]; do sleep .02; done
while true; do
  ttfx -i "$HOME/.config/omarchy/branding/screensaver.txt" --frame-rate 30 \
    --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --no-eol --no-restore-cursor &
  renderer=$!
  while kill -0 "$renderer" 2>/dev/null; do
    if read -r -s -n1 -t .2; then exit 0; fi
    hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1 || exit 0
  done
  wait "$renderer"
  result=$?
  renderer=
  if ((result!=0)); then echo "Screensaver renderer exited with status $result." >&2; exit "$result"; fi
  # Check input between effects as well, including very short effects.
  if read -r -s -n1 -t .1; then exit 0; fi
done
